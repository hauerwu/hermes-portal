# ── Hermes Portal ───────────────────────────────────────────────────────
# Copy to .env and adjust.

# Port the portal listens on (host side).
PORTAL_PORT=8080

# Public URL users/browsers reach the portal at (used for OIDC redirect
# URIs and absolute gateway URLs). No trailing slash.
PORTAL_PUBLIC_BASE_URL=http://localhost:8080

# Secret for signing portal JWTs. Generate with: openssl rand -hex 32
PORTAL_JWT_SECRET=change-me-generate-a-long-random-string

# Bootstrap super admin (first boot only).
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=change-me-strong-password

# ── Local hermes-agent instance runtime ─────────────────────────────────
# Image used for locally-created instances. Build it from the sibling
# hermes-agent repo (docker build -t hermes-agent ../hermes-agent) or use
# a prebuilt image such as nousresearch/hermes-agent.
PORTAL_HERMES_IMAGE=hermes-agent
# UID/GID the hermes containers remap their internal user to (should match
# a host user if you need to inspect the volumes).
PORTAL_HERMES_UID=1000
PORTAL_HERMES_GID=1000

# ── OIDC single sign-on (optional) ─────────────────────────────────────
PORTAL_OIDC_ENABLED=false
PORTAL_OIDC_ISSUER=
PORTAL_OIDC_CLIENT_ID=
PORTAL_OIDC_CLIENT_SECRET=
# Auto-create SSO users on first login (as member of the default tenant).
PORTAL_OIDC_AUTO_PROVISION=false
# Admin mapping: OIDC claim name whose truthy value grants the SSO user
# tenant_admin (members are upgraded on login, never downgraded).
PORTAL_OIDC_ADMIN_CLAIM=hermes_portal_admin

# ── Misc ────────────────────────────────────────────────────────────────
PORTAL_DEBUG=false
